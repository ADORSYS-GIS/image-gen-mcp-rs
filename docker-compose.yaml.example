services:
  image-mcp:
    build: .
    user: "0:0"
    ports:
      - "8080:8080"
    environment:
      - HOST=0.0.0.0
      - PORT=8080
      - OPENAI_GEN=false
      - NANO_BANANA=true
      - OUTPUT_FORMAT=file
      - OUTPUT_DIR=/app/outputs
      - RUST_LOG=info
      - OPENAI_API_KEY=${OPENAI_API_KEY}
    volumes:
      - ./outputs:/app/outputs
    restart: unless-stopped
